# Public origin of the deployed site. Used for <link rel="canonical">,
# og:url and og:image, which must be absolute for social scrapers to
# resolve them. Set this in the Vercel project environment.
#
# Without it the build still succeeds, but emits a warning and writes
# root-relative social URLs, which most scrapers will not follow.
VITE_SITE_ORIGIN=https://your-domain.com
